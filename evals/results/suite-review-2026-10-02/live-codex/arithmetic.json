  "source": "cases = (0, 1, 2, 3)\nrows = []\nfor n in cases:\n    lhs = sum(range(1, n + 1))\n    numerator = n * (n + 1)\n    rhs, remainder = divmod(numerator, 2)\n    rows.append({\"n\": n, \"lhs\": lhs, \"rhs\": rhs, \"remainder\": remainder, \"equal\": lhs == rhs})\nassert tuple(row[\"n\"] for row in rows) == cases\nassert all(row[\"remainder\"] == 0 and row[\"equal\"] for row in rows)\nassert [row[\"lhs\"] for row in rows] == [0, 1, 3, 6]\n",
