{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/math-research-experiment-manifest-v1.json",
  "title": "Mathematical research experiment manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "claim_id",
    "timestamp_utc",
    "repository",
    "environment",
    "mathematical_context",
    "command",
    "inputs",
    "assertion",
    "result",
    "outputs"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "claim_id": {"type": "string", "minLength": 1},
    "timestamp_utc": {"type": "string", "format": "date-time"},
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "dirty"],
      "properties": {
        "commit": {"type": "string", "minLength": 1},
        "dirty": {"type": "boolean"},
        "diff_sha256": {"type": ["string", "null"]}
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": true,
      "required": ["runtime", "software_versions"],
      "properties": {
        "runtime": {"type": "string"},
        "software_versions": {"type": "object"},
        "lockfiles": {"type": "array", "items": {"type": "string"}}
      }
    },
    "mathematical_context": {
      "type": "object",
      "additionalProperties": true,
      "required": ["coefficients", "convention_version"],
      "properties": {
        "coefficients": {"type": "string"},
        "precision": {"type": ["string", "null"]},
        "convention_version": {"type": "string"}
      }
    },
    "command": {
      "oneOf": [
        {"type": "string", "minLength": 1},
        {"type": "array", "items": {"type": "string"}, "minItems": 1}
      ]
    },
    "working_directory": {"type": "string"},
    "inputs": {"type": "object"},
    "limits": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "wall_time_seconds": {"type": ["number", "null"], "minimum": 0},
        "memory_mib": {"type": ["number", "null"], "minimum": 0},
        "cores": {"type": ["integer", "null"], "minimum": 1},
        "arity": {},
        "degree": {},
        "weight": {}
      }
    },
    "randomness": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "deterministic": {"type": "boolean"},
        "seed": {"type": ["integer", "string", "null"]}
      }
    },
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["statement"],
      "properties": {
        "statement": {"type": "string", "minLength": 1},
        "expected": {}
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": true,
      "required": ["status", "observed"],
      "properties": {
        "status": {
          "enum": ["passed", "failed", "inconclusive", "error"]
        },
        "observed": {},
        "duration_seconds": {"type": ["number", "null"], "minimum": 0}
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path"],
        "properties": {
          "path": {"type": "string"},
          "sha256": {"type": ["string", "null"]},
          "versioned": {"type": "boolean"}
        }
      }
    },
    "interpretation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "supports": {"type": "array", "items": {"type": "string"}},
        "does_not_show": {"type": "array", "items": {"type": "string"}},
        "notes": {"type": "string"}
      }
    }
  }
}
